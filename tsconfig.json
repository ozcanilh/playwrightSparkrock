{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "playwright.config.ts",
    "fixtures/**/*.ts",
    "pages/**/*.ts",
    "steps/**/*.ts",
    "tests/**/*.ts"
  ]
}
