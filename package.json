{
  "name": "sparkrock-qa-challenge",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "pretest": "node -e \"require('node:fs').rmSync('allure-results', { recursive: true, force: true })\"",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report:playwright": "playwright show-report playwright-report",
    "report:allure:generate": "allure generate allure-results --clean",
    "report:allure:open": "allure open allure-report"
  },
  "lint-staged": {
    "*.{ts,mjs,json,md,yml,yaml}": "prettier --check"
  },
  "overrides": {
    "allure": {
      "glob": "^14.0.6"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "allure": "^3.33.0",
    "allure-playwright": "^3.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3"
  }
}
